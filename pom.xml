<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Parent starter provides dependency versions and default plugin configuration. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <!-- Maven coordinates that uniquely identify this project. -->
    <groupId>edu.melbournepolytechnic</groupId>
    <artifactId>wiki-login</artifactId>
    <version>1.0.0</version>
    <name>wiki-login</name>
    <description>BIT235 Assessment 2 Part A - Wiki Administrator Login</description>

    <properties>
        <!-- Java 21 matches the JDK installed in the laboratory environment. -->
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <!-- Spring MVC web starter: embedded Tomcat, @Controller support and form handling. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Thymeleaf starter renders the HTML login, welcome and error templates. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Spring Boot Maven plugin lets the project run with 'mvn spring-boot:run'
                 and packages it as an executable jar. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
